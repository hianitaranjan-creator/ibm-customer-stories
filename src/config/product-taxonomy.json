  "_matching_rules": {
    "rule1": "A product is matched ONLY when an alias phrase appears verbatim (case-insensitive) in the story body text.",
    "rule2": "Generic terms — 'AI', 'analytics', 'cloud', 'data', 'machine learning', 'pipeline' — are NEVER aliases and NEVER trigger a match on their own.",
    "rule3": "If no alias from any product matches the story body, set productCategories = [] and flag the story as 'Needs review'.",
    "rule4": "When an alias matches, record the approvedName (not the alias) in the output. Preserve the original text phrase found in the story separately in productsMentioned for traceability.",
    "rule5": "Multiple products may match a single story."
